# Configuration for the Docker Compose stack. Copy to .env and fill in:
#
#   cp .env.example .env
#
# .env is gitignored. Only this example file is committed, and it must never
# hold a real key or password.
#
# This file configures the containers only. Running the services natively on
# the host still uses backend/.env and analytics-service/.env as before; this
# does not replace or read them.

# --- Required -------------------------------------------------------------
# Signs and verifies every auth token. Compose refuses to start without it,
# because the value in backend/.env.example is a public placeholder and
# anything signed with it can be forged by anyone who has read this repo.
#
# Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- External providers ---------------------------------------------------
# OGD_API_KEY and OPENAQ_API_KEY do NOT belong in this file.
#
# They stay in analytics-service/.env, which the analytics container reads
# directly through its bind mount. Keeping them in one place avoids two copies
# of a secret drifting apart, and listing them here would let an empty value
# silently shadow the real one -- an environment variable outranks the .env
# file, and every provider client treats an empty key as no key, so CPCB and
# OpenAQ would just report "skipped".
#
# Without those two keys, CPCB and OpenAQ are skipped and every other provider
# works as normal; none of the others needs a key.

# --- Database -------------------------------------------------------------
# These create the containerised database on first start. Changing them later
# has no effect unless the pgdata volume is deleted (docker compose down -v),
# because Postgres only reads them when initialising an empty data directory.
POSTGRES_USER=eia_user
POSTGRES_PASSWORD=eia_password
POSTGRES_DB=eia_platform

# --- Host ports -----------------------------------------------------------
# Change any of these if something on the host already holds the port.
# The database deliberately avoids 5432, which a local PostgreSQL install
# usually occupies.
FRONTEND_PORT=5173
BACKEND_PORT=5000
ANALYTICS_PORT=8000
DB_PORT=5433

# --- Tuning ---------------------------------------------------------------
JWT_EXPIRES_IN=7d
# A baseline fetch can spend up to 240 s in one provider. Keep this under
# 300000: Node's fetch times out waiting for response headers at 300 s.
ANALYTICS_TIMEOUT_MS=270000
