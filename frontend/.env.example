# Leave unset to use the dev server's /api proxy (see vite.config.ts).
# Set it only when the backend is not reachable through that proxy, e.g.
# VITE_API_BASE_URL=https://api.example.org/api
# VITE_API_BASE_URL=

# Where the dev proxy forwards /api. Defaults to the backend's default port.
# VITE_PROXY_TARGET=http://localhost:5000
