# Repository-root ignores. Each service also has its own .gitignore.

# Compose reads this file for the stack's configuration, and it holds the JWT
# secret and the two provider API keys. Only .env.example is committed.
.env
.env.*
!.env.example

# Editor and OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
