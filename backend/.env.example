# Server
PORT=5000
NODE_ENV=development

# PostgreSQL / PostGIS
DATABASE_URL=postgresql://eia_user:eia_password@localhost:5432/eia_platform

# Auth
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# CORS. Only used when the browser talks to this server directly; the Vite
# dev server proxies /api, so in normal development nothing is cross-origin.
# 5173 is Vite's default port.
CLIENT_ORIGIN=http://localhost:5173

# FastAPI analytics service
ANALYTICS_SERVICE_URL=http://localhost:8000
# An environmental data fetch takes 1-4 minutes (each provider may use up to 240 s).
# Keep below 300000: Node's fetch has a 300 s response-headers timeout.
ANALYTICS_TIMEOUT_MS=270000
