# Server
PORT=8000

# CORS - the Node backend (and later, the frontend dev server) calling this service
CORS_ORIGINS=http://localhost:5000,http://localhost:3000

# This service is stateless: it does NOT connect to the database.
# The Node backend persists everything it returns.

# Default search radius (km) for nearby stations / wide-area GIS features (max 25)
DEFAULT_RADIUS_KM=25
MAX_OBSERVATION_AGE_DAYS=30

# OpenAQ v3 air-quality stations. Get a key: https://docs.openaq.org/using-the-api/api-key
# Leave empty and OpenAQ is reported as "skipped".
OPENAQ_API_KEY=

# data.gov.in (India OGD) key, used for CPCB real-time air quality stations.
# Register at https://data.gov.in. Leave empty and CPCB is reported as "skipped".
OGD_API_KEY=

# Overpass (OpenStreetMap) endpoints, tried in order
OVERPASS_ENDPOINTS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter,https://overpass.kumi.systems/api/interpreter

CLIMATE_HISTORY_YEARS=10
